{
  "name": "QueryUnstuck",
  "handle": "@queryunstuck",
  "watermark": "queryunstuck",
  "tagline": "Data & AI Engineering, visualized.",
  "fonts": {
    "heading": "Montserrat",
    "body": "Montserrat",
    "code": "JetBrains Mono"
  },
  "colors": {
    "background": "#0A1628",
    "surface": "#122340",
    "surfaceAlt": "#1A3157",
    "primary": "#1E4B8F",
    "accent": "#FFC72C",
    "text": "#FFFFFF",
    "textMuted": "#9FB0CC",
    "border": "#2E4A78"
  },
  "semantic": {
    "active": "#FFC72C",
    "match": "#22C55E",
    "noMatch": "#EF4444",
    "pending": "#64748B",
