      "#38BDF8",
      "#A78BFA",
      "#F472B6",
      "#34D399",
      "#FB923C",
      "#A3E635"
    ]
  },
  "layout": {
    "reel": {
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "titleZone": [
        0,
        380
      ],
