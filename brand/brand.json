      "blip": 0.3,
      "ding": 0.6,
      "thud": 0.6,
      "buzz": 0.4,
      "swoosh": 0.2,
      "glide": 0.35,
      "slide": 0.3,
      "snap": 0.35,
      "sparkle": 0.3,
      "chime": 0.5,
      "type": 0.3,
      "outro": 0.7
