        380,
        1250
      ],
      "codeZone": [
        1250,
        1650
      ],
      "safeBottom": 270,
      "safeRight": 140,
      "margin": 72
    },
    "landscape": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "titleZone": [
        0,
        200
      ],
      "contentZone": [
        200,
        980
      ],
      "margin": 96,
      "safeBottom": 100,
      "safeRight": 96,
      "codeSplit": 0.42
    }
  },
  "links": {
    "website": "TBD",
    "newsletter": "TBD",
    "discord": "TBD",
    "youtube": "TBD",
    "instagram": "TBD"
  },
  "syntax": {
    "keyword": "#FFC72C",
    "function": "#38BDF8",
    "string": "#34D399",
    "number": "#FB923C",
    "comment": "#64748B",
    "operator": "#A78BFA",
    "identifier": "#FFFFFF",
    "punctuation": "#9FB0CC"
  },
  "radius": {
    "card": 28,
    "chip": 14
