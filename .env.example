# Copy to .env (never commit). Mirror each value into GitHub repo Secrets for Actions.
ANTHROPIC_API_KEY=

# Instagram (Meta Graph API) – Phase 5
IG_USER_ID=
IG_ACCESS_TOKEN=
META_GRAPH_VERSION=        # use the current version from Meta docs, e.g. vXX.0

# YouTube Data API v3 – Phase 5
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Video hosting (Instagram fetches videos from a public URL) – Phase 3+
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=queryunstuck-media
R2_PUBLIC_BASE_URL=

# Behaviour
DRY_RUN=true               # publisher only logs until you flip this to false
TIMEZONE=Asia/Kolkata
